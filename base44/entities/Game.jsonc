{
  "name": "Game",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "finished"
      ],
      "default": "waiting"
    },
    "host_id": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "called_arguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "host_card": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "host_marks": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "default": []
    },
    "guest_card": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "guest_marks": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "default": []
    },
    "winner": {
      "type": "string",
      "enum": [
        "host",
        "guest",
        ""
      ],
      "default": ""
    }
  },
  "required": [
    "room_code"
  ]
}