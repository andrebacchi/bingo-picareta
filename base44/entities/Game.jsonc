{
  "name": "Game",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "finished"
      ],
      "default": "waiting"
    },
    "host_id": {
      "type": "string"
    },
    "called_arguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "first_line_player_id": {
      "type": "string",
      "default": ""
    },
    "first_line_player_name": {
      "type": "string",
      "default": ""
    },
    "winner_id": {
      "type": "string",
      "default": ""
    },
    "winner_name": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "room_code"
  ]
}