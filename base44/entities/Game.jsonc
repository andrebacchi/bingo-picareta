{
  "name": "Game",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "finished"
      ],
      "default": "waiting"
    },
    "host_id": {
      "type": "string"
    },
    "called_arguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "first_line_player_id": {
      "type": "string",
      "default": ""
    },
    "first_line_player_name": {
      "type": "string",
      "default": ""
    },
    "winner_id": {
      "type": "string",
      "default": ""
    },
    "winner_name": {
      "type": "string",
      "default": ""
    },
    "winner_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "winner_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "win_mode": {
      "type": "string",
      "enum": [
        "line",
        "full"
      ],
      "default": "full"
    },
    "taunt_text": {
      "type": "string",
      "default": ""
    },
    "taunt_author": {
      "type": "string",
      "default": ""
    },
    "taunt_kind": {
      "type": "string",
      "enum": [
        "taunt",
        "complaint"
      ],
      "default": "taunt"
    },
    "taunt_seq": {
      "type": "number",
      "default": 0
    },
    "winner_taunt": {
      "type": "string",
      "default": ""
    },
    "winner_taunts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "taunt": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "quina_player_name": {
      "type": "string",
      "default": ""
    },
    "quina_seq": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "room_code"
  ]
}